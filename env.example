# Example Environment Variables
# Copy these values into a new `.env` file in the root directory:

# Discord Bot Token (Discord Developer Portal -> Bot -> Reset Token)
DISCORD_TOKEN=your_bot_token_here

# Discord Client / Application ID (Developer Portal -> General Information)
CLIENT_ID=your_client_id_here

# (Optional) Guild ID for instant slash command registration during testing.
# If left blank, commands register globally across all joined servers.
GUILD_ID=

# (Optional) Staff Role ID: Members with this role can run /add, /set, /remove, /live
# If left blank, only members with Administrator permissions can manage spending.
STAFF_ROLE_ID=

# Display name printed at the top left of the generated leaderboard image
SHOP_NAME=STOCKS LEADERBOARD

# Timezone for the footer "Updated" timestamp
TIMEZONE=Asia/Kuala_Lumpur

# Prefix text used in the auto-updating bot uptime Bio
BIO_TEXT=Leaderboard Ranking
