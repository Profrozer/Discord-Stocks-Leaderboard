# Example Environment Variables
# Copy these values into a new `.env` file in the root directory:

# Discord Bot Token (Discord Developer Portal -> Bot -> Reset Token)
DISCORD_TOKEN=your_bot_token_here

# Discord Client / Application ID (Developer Portal -> General Information)
CLIENT_ID=your_client_id_here

# (Optional) Guild ID for instant slash command registration during testing.
# If left blank, commands register globally across all joined servers.
GUILD_ID=

# (Optional) Staff Role ID for /add, /set, /remove, /live and /backup.
# Administrators can also run these commands. /restore is always Administrator-only.
STAFF_ROLE_ID=

# Display name printed at the top left of the generated leaderboard image
SHOP_NAME=STOCKS LEADERBOARD

# Timezone for the footer "Updated" timestamp
TIMEZONE=Asia/Kuala_Lumpur

# Prefix text used in the bot bio, above the total active time
BIO_TEXT=Leaderboard Ranking

# (Optional) Private Discord channel ID for JSON backups and fresh-database recovery.
# Leave blank to disable Discord backups. Local backups still run.
# Give the bot View Channel, Send Messages, Attach Files and Read Message History.
BACKUP_CHANNEL_ID=

# Interval in hours for both local and Discord backups. Checked hourly.
BACKUP_EVERY_HOURS=48

# Optional RSS limit in MB. 0 disables it. If exceeded, the bot exits with code 1.
# Enable only if your host or process manager is configured to restart the bot.
MEMORY_RESTART_MB=0
