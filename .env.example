# Copy this file to a new file named exactly ".env" and fill it in.
# No quotes, no spaces around "=".

# Developer Portal -> your app -> Bot -> Reset Token
DISCORD_TOKEN=

# Developer Portal -> your app -> General Information -> Application ID
CLIENT_ID=

# Your server ID (right-click server with Developer Mode on -> Copy Server ID).
# Commands appear instantly when this is set.
GUILD_ID=

# Optional: members with this role can use /add and /remove (Administrators always can)
STAFF_ROLE_ID=

# Name shown on the leaderboard image
SHOP_NAME=DOGE

# Optional: timezone for the "Updated" time on the image
TIMEZONE=Asia/Kuala_Lumpur
